rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
    match /products/{allPaths=**} {
      // Allow anyone to read product images
      allow read;
      // Only allow authenticated users to upload
      allow write: if request.auth != null;
    }
    match /company-logos/{allPaths=**} {
      // Allow anyone to read companies images
      allow read;
      // Only allow authenticated companies to upload
      allow write: if request.auth != null;
    }
    match /category-images/{allPaths=**} {
      // Allow anyone to read categories images
      allow read;
      // Only allow authenticated companies to upload
      allow write: if request.auth != null;
    }
  }
}